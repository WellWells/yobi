{
  "name": "yobi",
  "version": "1.5.0",
  "description": "Desktop AI automation that drives the ChatGPT, Gemini, Perplexity, and Duck.ai web interfaces via global hotkeys, with visual flows, scheduling, and Telegram/LINE bot control.",
  "author": "WellsTsai",
  "repository": {
    "type": "git",
    "url": "https://github.com/WellWells/yobi.git"
  },
  "bugs": {
    "url": "https://github.com/WellWells/yobi/issues"
  },
  "homepage": "https://github.com/WellWells/yobi#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron out/main/index.js",
    "dev": "tsx scripts/electron-dev.ts",
    "build:compile": "vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts && vite build -c vite.renderer.config.ts",
    "prepare:icons": "tsx scripts/generate-icons.ts",
    "licenses:generate": "tsx scripts/generate-licenses.ts",
    "build:win": "npm run prepare:icons && npm run build:compile && npm run licenses:generate && electron-builder --win",
    "build:msix": "npm run prepare:icons && npm run build:compile && npm run licenses:generate && electron-builder --win appx",
    "build:mac": "npm run prepare:icons && npm run build:compile && npm run licenses:generate && electron-builder --mac",
    "build": "npm run build:win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "i18n:check": "tsx scripts/i18n-check.ts"
  },
  "keywords": [
    "electron",
    "desktop-app",
    "cross-platform",
    "ai",
    "ai-automation",
    "automation",
    "workflow-automation",
    "no-code",
    "llm",
    "chatgpt",
    "gemini",
    "perplexity",
    "duckai",
    "telegram-bot",
    "line-bot",
    "global-hotkey",
    "clipboard",
    "productivity",
    "markdown",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@grammyjs/conversations": "^2.1.1",
    "@line/bot-sdk": "^11.2.0",
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/modals": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tanstack/react-virtual": "^3.14.10",
    "adm-zip": "^0.6.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "fdir": "^6.5.0",
    "grammy": "^1.46.0",
    "jsonrepair": "^3.15.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.34.0",
    "marked": "^18.0.11",
    "mermaid": "^11.17.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.1",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "systeminformation": "^5.33.4",
    "tokenx": "^2.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.4.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.11.10",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.wellstsai.yobi",
    "productName": "Yobi",
    "executableName": "Yobi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.js.map",
      "!out/**/*.css.map"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "WellWells",
        "repo": "yobi"
      }
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "*.png",
          "*.ico",
          "*.icns"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD-PARTY-LICENSES.txt",
        "to": "THIRD-PARTY-LICENSES.txt"
      }
    ],
    "win": {
      "icon": "assets/icon-win.ico",
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "artifactName": "Yobi-${version}-win-x64-Setup.exe"
    },
    "appx": {
      "applicationId": "Yobi",
      "identityName": "wellstsai.YobiAI",
      "publisher": "CN=BF03D00F-7701-4B9B-AA3B-BC3A391584C3",
      "publisherDisplayName": "wellstsai",
      "displayName": "Yobi AI",
      "showNameOnTiles": true,
      "minVersion": "10.0.17763.0",
      "languages": [
        "en-US",
        "zh-CN",
        "zh-TW"
      ],
      "artifactName": "Yobi-${version}-win-${arch}.msix"
    },
    "mac": {
      "icon": "assets/icon-mac.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Yobi-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Yobi-${version}-mac-${arch}.dmg"
    }
  },
  "overrides": {
    "yauzl": "^3.3.1"
  }
}
