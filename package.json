{
  "name": "yobi",
  "version": "1.12.0",
  "description": "Desktop AI automation: scheduled flows, chat, global hotkeys and Telegram/LINE bots that drive the Gemini, Claude, ChatGPT and Perplexity web apps without an API key (or with your own).",
  "author": "WellsTsai",
  "repository": {
    "type": "git",
    "url": "https://github.com/WellWells/yobi.git"
  },
  "bugs": {
    "url": "https://github.com/WellWells/yobi/issues"
  },
  "homepage": "https://github.com/WellWells/yobi#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "out/main/entry.cjs",
  "scripts": {
    "start": "electron out/main/entry.cjs",
    "dev": "tsx scripts/electron-dev.ts",
    "build:compile": "vite build -c vite.main.config.mts && vite build -c vite.preload.config.mts && vite build -c vite.renderer.config.mts",
    "prepare:icons": "tsx scripts/generate-icons.ts",
    "prepare:line-core": "tsx scripts/prepareLineCore.ts",
    "licenses:generate": "tsx scripts/generate-licenses.ts",
    "check:bundle": "tsx scripts/checkBundleExternals.ts",
    "build:win": "npm run prepare:line-core -- --release && npm run prepare:icons && npm run build:compile && npm run check:bundle && npm run licenses:generate && electron-builder --win",
    "build:mac": "npm run prepare:icons && npm run build:compile && npm run check:bundle && npm run licenses:generate && electron-builder --mac",
    "build": "npm run build:win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "i18n:check": "tsx scripts/i18n-check.ts"
  },
  "keywords": [
    "electron",
    "desktop-app",
    "cross-platform",
    "ai",
    "ai-automation",
    "automation",
    "workflow-automation",
    "no-code",
    "llm",
    "chatgpt",
    "gemini",
    "perplexity",
    "deepseek",
    "telegram-bot",
    "line-bot",
    "global-hotkey",
    "clipboard",
    "productivity",
    "markdown",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@fuman/node": "0.0.23",
    "@grammyjs/conversations": "^2.1.1",
    "@line/bot-sdk": "^11.4.0",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "0.6.0",
    "@mtcute/core": "0.32.7",
    "@mtcute/wasm": "0.32.6",
    "@tanstack/react-virtual": "^3.14.26",
    "adm-zip": "^0.6.1",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "cheerio": "^1.2.0",
    "country-flag-icons": "^1.6.20",
    "dayjs": "^1.11.23",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "fdir": "^6.5.0",
    "grammy": "^1.46.0",
    "ical.js": "^2.2.1",
    "imapflow": "^2.11.0",
    "jsonrepair": "^3.15.0",
    "katex": "^0.19.1",
    "koffi": "^3.3.7",
    "linkedom": "0.18.15",
    "lucide-react": "^1.70.0",
    "mailparser": "^3.14.2",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.4.0",
    "opencc-js": "^1.4.2",
    "openpgp": "^6.3.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.0",
    "react-markdown": "^10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.6.0",
    "systeminformation": "^5.33.19",
    "thunderbird-mcp": "github:TKasperczyk/thunderbird-mcp#v0.7.4",
    "tokenx": "^2.2.0",
    "tsdav": "2.5.0",
    "tyme4ts": "^1.5.5",
    "unified": "^11.0.5",
    "unpdf": "^2.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.4",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.wellstsai.yobi",
    "productName": "Yobi",
    "executableName": "Yobi",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!out/**/*.js.map",
      "!out/**/*.css.map",
      "!out/*.tsbuildinfo",
      "!node_modules/**/*",
      "node_modules/better-sqlite3-multiple-ciphers/package.json",
      "node_modules/better-sqlite3-multiple-ciphers/lib/**/*",
      "node_modules/better-sqlite3-multiple-ciphers/prebuilds/win32-*.node",
      "node_modules/better-sqlite3-multiple-ciphers/prebuilds/darwin-*.node",
      "node_modules/koffi/package.json",
      "node_modules/koffi/index.cjs",
      "node_modules/koffi/indirect.cjs",
      "node_modules/koffi/index.js",
      "node_modules/koffi/indirect.js",
      "node_modules/koffi/src/koffi/**/*.cjs",
      "node_modules/koffi/src/koffi/**/*.js",
      "node_modules/@koromix/koffi-win32-x64/**/*",
      "node_modules/thunderbird-mcp/package.json",
      "node_modules/thunderbird-mcp/mcp-bridge.cjs",
      "node_modules/thunderbird-mcp/LICENSE"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3-multiple-ciphers/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/koffi-win32-x64/**",
      "node_modules/thunderbird-mcp/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "WellWells",
        "repo": "yobi"
      }
    ],
    "extraResources": [
      {
        "from": "assets/skills/",
        "to": "skills/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "*.png",
          "*.ico",
          "*.icns"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD-PARTY-LICENSES.txt",
        "to": "THIRD-PARTY-LICENSES.txt"
      }
    ],
    "win": {
      "icon": "assets/icon-win.ico",
      "extraResources": [
        {
          "from": "build-native/line.dll",
          "to": "line.dll"
        },
        {
          "from": "NOTICE",
          "to": "NOTICE"
        }
      ],
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker",
      "electronLanguages": [
        "en-US",
        "zh-CN",
        "zh-TW",
        "de",
        "es",
        "fr",
        "ja",
        "ko",
        "pt-BR"
      ]
    },
    "nsis": {
      "artifactName": "Yobi-${version}-win-x64-Setup.exe"
    },
    "mac": {
      "icon": "assets/icon-mac.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "Yobi-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Yobi-${version}-mac-${arch}.dmg"
    }
  },
  "overrides": {
    "katex": "$katex",
    "lodash-es": "^4.18.1",
    "node-fetch": {
      "whatwg-url": "^17.3.0"
    }
  }
}
